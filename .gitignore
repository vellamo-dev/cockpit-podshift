# OS and editor
.DS_Store
*.swp
*.swo
*~
.vscode/
# IntelliJ user state only; keep shared project files and .run/ configs
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/queries/
.idea/markdown.xml

# Secrets (keep committed example files)
.env
.env.*
!.env.example

# Dependencies and build output
# package-lock.json is tracked; do not ignore it.
# dist/ is committed: the RPM installs this pre-built tree.
# The build empties the folder in place and must not delete it (VM shares).
node_modules/
/metafile.json
/runtime-npm-modules.txt

# Translation templates and the LINGUA list are generated by make.
# Keep handwritten src/po/*.po files (for example src/po/de.po).
/src/po/*.pot
/src/po/LINGUAS

# Build and test artefacts (only readme.md is tracked)
artifacts/*
!artifacts/readme.md
*.log
*.log.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/
*.lcov

# Local VM or disk images if they appear in the tree
*.qcow2
*.img
.lima/

# Built packages
*.rpm
*.tar.xz
