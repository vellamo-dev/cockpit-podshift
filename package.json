{
    "name": "podshift",
    "description": "Cockpit UI for PodShift",
    "type": "module",
    "main": "src/app/index.jsx",
    "author": "Vellamo.fyi",
    "license": "AGPL-3.0-or-later",
    "engines": {
        "node": ">= 16"
    },
    "scripts": {
        "addExamplesToPodShiftVM": "../podshift/test postinstall-examples",
        "build": "./src/dev/run make",
        "buildAndInstallRpm": "npm run build && ../podshift/test bundle-ui-rpm-install-examples",
        "buildAndSyncUIinVM": "npm run build && ../podshift/test postinstall-ui-sync-files",
        "buildRpm": "../podshift/test ui-rpm-build",
        "rebuild": "./src/dev/run make -W build.js",
        "eslint": "eslint --ext .js,.jsx src/",
        "eslint:fix": "eslint --fix --ext .js,.jsx src/",
        "runPodShiftVM": "../podshift/test bundle-ui-dev-mount",
        "runPodShiftVMWithExamples": "../podshift/test bundle-ui-dev-mount-examples",
        "stylelint": "stylelint src/app/*.{css,scss}",
        "stylelint:fix": "stylelint --fix src/app/*.{css,scss}",
        "syncUIinVM": "../podshift/test postinstall-ui-sync-files",
        "test": "./src/dev/run npx qunit \"src/test/unit/*.test.js\"",
        "updateTranslations": "rm -f src/po/*.pot && ./src/dev/run make src/po/podshift.pot && for f in src/po/*.po; do ./src/dev/run msgmerge --update --backup=none \"$f\" src/po/podshift.pot || exit 1; done",
        "watch": "./src/dev/run make watch"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "@types/react": "18.3.31",
        "esbuild-wasm": "0.28.2",
        "eslint": "8.57.1",
        "eslint-config-standard": "17.1.0",
        "eslint-config-standard-jsx": "11.0.0",
        "eslint-config-standard-react": "13.0.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "50.8.0",
        "eslint-plugin-node": "11.1.0",
        "eslint-plugin-promise": "6.6.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "4.6.2",
        "qunit": "3.0.0",
        "stylelint": "17.16.0",
        "stylelint-config-recommended-scss": "17.0.1",
        "stylelint-config-standard": "40.0.0",
        "stylelint-config-standard-scss": "17.0.0",
        "stylelint-formatter-pretty": "4.0.1"
    },
    "dependencies": {
        "@patternfly/patternfly": "6.6.1",
        "@patternfly/react-core": "6.6.2",
        "@patternfly/react-icons": "6.6.1",
        "@patternfly/react-styles": "6.6.1",
        "esbuild": "0.28.2",
        "esbuild-sass-plugin": "3.7.0",
        "gettext-parser": "10.0.0",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    }
}
